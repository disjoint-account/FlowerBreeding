{
	"schemaVersion": 1,
	"id": "flowerbreeding",
	"version": "${version}",
	"name": "Flower Breeding",
	"description": "A mod for all things plants and flowers, inspired by LDShadowLady's Flower Breeding.",
	"authors": [
		"disjoint",
		"steelpandas"
	],
	"contact": {
		"homepage": "https://modrinth.com/project/flowerbreeding",
		"sources": "https://github.com/disjoint-account/FlowerBreeding",
		"issues": "https://github.com/disjoint-account/FlowerBreeding/issues"
	},
	"license": "MIT",
	"icon": "assets/flowerbreeding/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.flowerbreeding.FlowerBreeding"
		],
		"client": [
			"net.flowerbreeding.FlowerBreedingClient"
		],
		"fabric-datagen": [
			"net.flowerbreeding.datagen.FBDataGenerator"
		],
		"modmenu": [
			"net.flowerbreeding.config.ModMenuIntegration"
		],
		"rei_common": [
			"net.flowerbreeding.compat.FBREICommon"
		],
		"rei_client": [
			"net.flowerbreeding.compat.FBREIClient"
		]
	},
	"mixins": [
	],
	"depends": {
		"fabricloader": ">=0.19.0",
		"minecraft": ">=21.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
